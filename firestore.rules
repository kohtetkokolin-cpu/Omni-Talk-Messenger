rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user (including anonymous) can read profiles (needed
    // to look someone up by friendCode) and can write only their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 1-on-1 chats (collection name used by this app: direct_chats).
    // Room ID is a deterministic combination of both UIDs, so anyone
    // signed in can create/open one — but only the two participants
    // (encoded in the room ID) can read or write its messages.
    match /direct_chats/{roomId} {
      allow read, write: if request.auth != null && roomId.matches('.*' + request.auth.uid + '.*');

      match /messages/{messageId} {
        allow read: if request.auth != null && roomId.matches('.*' + request.auth.uid + '.*');
        allow create: if request.auth != null && roomId.matches('.*' + request.auth.uid + '.*');
      }
    }

    // Groups: only members can read/write; only members can post messages.
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }
  }
}
